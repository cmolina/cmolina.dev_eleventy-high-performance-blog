---
export const meta = { title: 'About Me' };

import Image from '../../components/Image.astro';
import Base from '../../layouts/Base.astro';
import carlosImg from '../../assets/img/about/me/carlos.jpg';
import elephantImg from '../../assets/img/about/me/elephant.jpg';
import llamaImg from '../../assets/img/about/me/llama.jpg';
import rubberDuckImg from '../../assets/img/about/me/rubber-duck.jpg';
import salamanderImg from '../../assets/img/about/me/salamander-frozen-2.jpg';

const SITE_URL = 'https://cmolina.dev';
const personId = `${SITE_URL}/#person`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'About', item: `${SITE_URL}/about/me/` },
      ],
    },
    {
      '@type': 'ProfilePage',
      url: `${SITE_URL}/about/me/`,
      name: 'About Me | Carlos Molina',
      mainEntity: {
        '@type': 'Person',
        '@id': personId,
        name: 'Carlos Molina',
        alternateName: 'Carlos Andrés Molina Avendaño',
        url: `${SITE_URL}/`,
        image: `${SITE_URL}/og/about/me.png`,
        jobTitle: 'Software Architect',
        sameAs: [
          'https://www.linkedin.com/in/carlosmolinaav/',
          'https://github.com/cmolina',
          'https://twitter.com/camolin3',
        ],
      },
    },
  ],
};
---

<Base
  title="About Me"
  description="Meet Carlos Molina — software architect and mentor. Passionate about clarity, sustainability, and code that lasts decades."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span class="current" aria-current="page">About</span>
  </nav>

  <!-- Hero Header -->
  <header class="page-header">
    <h1 class="headline-xl">¡Hola! I'm Carlos.</h1>
    <p class="body-lg muted italic">
      I like to write code that is simple to read and understand — although I like to delete code
      even more.
    </p>
  </header>

  <!-- Bento intro -->
  <section class="bento">
    <div class="bento__photo">
      <Image
        src={carlosImg}
        alt="Portrait of Carlos Molina"
        width="400"
        height="400"
        class="bento-img"
      />
    </div>
    <div class="bento__card">
      <h2 class="headline-md">How I think about software</h2>
      <p class="body-md">
        I like to write code that is simple to read and understand. Whatever I build, I try to
        keep it simple enough that someone else — or future me — can still make sense of it.
      </p>
      <div class="bento__tags">
        <span class="tag tag--accent">Architecture</span>
        <span class="tag tag--accent">Sustainability</span>
        <span class="tag">Precision</span>
      </div>
    </div>
  </section>

  <!-- Beyond the Screen -->
  <section class="hobbies">
    <div class="hobbies__meta">
      <span class="label-sm accent">Beyond the Screen</span>
    </div>
    <h2 class="headline-lg">A Life in Chapters</h2>
    <p class="body-md muted">
      When I'm not architecting systems, I'm usually immersed in a world of narrative. Audiobooks
      are my sanctuary — a way to explore complex ideas while remaining physically present in the
      world. From non-fiction deep dives to speculative fiction, the structure of a good story
      often informs the structure of my code.
    </p>
    <p class="body-md muted">
      My favourite audiobooks include <em>The Richest Man in Babylon</em> by George S. Clason,
      <em>Twelve Pillars</em> by Jim Rohn, and <em>How to Win Friends &amp; Influence People</em>
      by Dale Carnegie. I've also enjoyed <em>Misbehaving</em>, the Steve Jobs biography, and
      <em>Spaceman</em> by Mike Massimino.
    </p>
    <p class="body-md muted">
      Outside of reading, I practice whittling, do CrossFit, and go trekking in the Araucanía.
      At home I'm kept company by my dog Capuchino and my cat Punto.
    </p>

    <div class="whittling-grid">
      <figure class="whittling-item">
        <Image src={elephantImg} alt="Whittled elephant" width="200" height="200" class="whittling-img" />
      </figure>
      <figure class="whittling-item">
        <Image src={llamaImg} alt="Whittled llama" width="200" height="200" class="whittling-img" />
      </figure>
      <figure class="whittling-item">
        <Image src={rubberDuckImg} alt="Whittled rubber duck" width="200" height="200" class="whittling-img" />
      </figure>
      <figure class="whittling-item">
        <Image src={salamanderImg} alt="Whittled salamander" width="200" height="200" class="whittling-img" />
      </figure>
    </div>
  </section>

  <!-- Currently Building -->
  <section class="current-work">
    <div class="current-work__meta">
      <span class="label-sm accent">Currently Building</span>
    </div>
    <h2 class="headline-lg">Molina Systems</h2>
    <p class="body-md muted">
      I'm currently working on <a href="https://molina.systems">Molina Systems</a>, where I help
      small businesses get online presence — from a simple landing page to a complete digital setup.
    </p>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2 class="headline-lg">Ready to build something meaningful?</h2>
    <p class="body-md muted">
      I'm currently open to collaborations on projects that value long-term technical health and
      human-centred design.
    </p>
    <a href="mailto:hola@cmolina.dev" class="btn-primary">Get in touch</a>
  </section>
</Base>

<style>
  /* ---- Breadcrumbs ---- */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    /* override global article > nav */
    justify-content: flex-start;
    padding: 0;
    list-style: none;
    flex-wrap: nowrap;
  }

  .breadcrumbs a {
    color: var(--on-surface-variant, #444748);
    text-decoration: none;
  }

  .breadcrumbs a:hover { color: var(--color); }

  .breadcrumbs span { color: var(--on-surface-variant, #444748); }
  .breadcrumbs .current { color: var(--color); }

  /* ---- Typography ---- */
  .page-header {
    margin-bottom: 4rem;
  }

  .headline-xl {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color);
    margin: 0 0 1.5rem;
  }

  .headline-lg {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color);
    margin: 0 0 1.5rem;
  }

  .headline-md {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color);
    margin: 0 0 0.75rem;
  }

  .body-lg {
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .body-md {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .muted { color: var(--on-surface-variant, #444748); }
  .italic { font-style: italic; }

  .label-sm {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .accent { color: var(--secondary, #5c3cdc); }

  /* ---- Bento ---- */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 5rem;
  }

  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  :global(.bento-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bento__photo {
    background-color: var(--surface-container, #efeded);
    border: 1px solid var(--outline-variant, #c4c7c7);
    overflow: hidden;
    aspect-ratio: 1;
  }

  .bento__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 4px solid var(--secondary, #5c3cdc);
    background-color: var(--surface-container-low, #f5f3f3);
  }

  .bento__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    background-color: var(--surface-container, #efeded);
    color: var(--on-surface-variant, #444748);
  }

  .tag--accent {
    background-color: var(--secondary, #5c3cdc);
    color: #fff;
  }

  /* ---- Hobbies ---- */
  .hobbies {
    background-color: var(--surface-container, #efeded);
    padding: 2rem;
    margin-bottom: 5rem;
  }

  .hobbies__meta {
    margin-bottom: 1rem;
  }

  /* ---- Whittling grid ---- */
  .whittling-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 480px) {
    .whittling-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .whittling-item {
    margin: 0;
    overflow: hidden;
    background-color: var(--surface-container-low, #f5f3f3);
    aspect-ratio: 1;
  }

  :global(.whittling-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .whittling-item:hover :global(.whittling-img) {
    transform: scale(1.04);
  }

  /* ---- Currently Building ---- */
  .current-work {
    padding: 2rem 0;
    margin-bottom: 5rem;
    border-top: 1px solid var(--outline-variant, #c4c7c7);
  }

  .current-work__meta {
    margin-bottom: 1rem;
  }

  .current-work a {
    color: var(--secondary, #5c3cdc);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .current-work a:hover { color: var(--color); }

  /* ---- CTA ---- */
  .cta {
    text-align: center;
    padding: 4rem 0;
    border-top: 1px solid var(--outline-variant, #c4c7c7);
    margin-bottom: 2rem;
  }

  .cta .headline-lg {
    margin-bottom: 0.75rem;
  }

  .cta .body-md {
    max-width: 40rem;
    margin: 0 auto 2rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: var(--secondary, #5c3cdc);
    border: 2px solid var(--secondary, #5c3cdc);
    color: #fff;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s, border-color 0.3s;
  }

  .btn-primary:hover {
    background: var(--color);
    border-color: var(--color);
    color: var(--surface, #fbf9f8);
  }

  h1, h2, h3 { margin-top: 0; }
</style>
