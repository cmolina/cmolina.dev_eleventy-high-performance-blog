---
import Image from '../components/Image.astro';
import Base from '../layouts/Base.astro';
import PostsList from '../components/PostsList.astro';
import carlosImg from '../assets/img/about/me/carlos.jpg';
import { getCollection } from 'astro:content';
import { isPublished, sortByDate } from '../utils/posts';

const allPosts = await getCollection('posts');
const recentPosts = sortByDate(allPosts.filter(isPublished)).slice(0, 3);

const SITE_URL = 'https://cmolina.dev';
const personId = `${SITE_URL}/#person`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Carlos Molina',
      alternateName: 'Carlos Andrés Molina Avendaño',
      url: `${SITE_URL}/`,
      image: { '@type': 'ImageObject', url: `${SITE_URL}/og/home.png` },
      jobTitle: 'Software Architect',
      description:
        'I help companies and teams deliver software that delights, on time, by bridging the gap between technical architecture and sustainable business goals.',
      sameAs: [
        'https://www.linkedin.com/in/carlosmolinaav/',
        'https://github.com/cmolina',
      ],
      knowsAbout: [
        'Software Architecture',
        'TypeScript',
        'CI/CD Pipelines',
        'Technical Leadership',
        'Accessibility',
        'JavaScript',
        'Software Testing',
      ],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Software Architect',
        occupationLocation: { '@type': 'Country', name: 'Chile' },
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Molina Systems',
        url: 'https://molina.systems',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer enquiries',
        email: 'hola@cmolina.dev',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'Carlos Molina',
      description:
        'I help companies and teams deliver software that delights, on time, by bridging the gap between technical architecture and sustainable business goals.',
      publisher: { '@id': personId },
      inLanguage: 'en',
    },
  ],
};
---

<Base title="Software Architecture Consultant" description="I help companies and teams deliver software that delights, on time, by bridging the gap between technical architecture and sustainable business goals.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  <!-- Hero -->
  <section class="hero">
    <div class="hero__text">
      <h1 class="headline-xl">Software Architecture Consulting for Engineering Teams.</h1>
      <p class="body-lg muted">
        I help companies and teams deliver software that delights, on time, by bridging the gap
        between technical architecture and sustainable business goals.
      </p>
      <a href="/about/services/" class="btn-outline">View Services</a>
    </div>
    <div class="hero__image">
      <Image
        src={carlosImg}
        alt="Carlos Molina"
        width="280"
        height="280"
        fetchpriority="high"
        loading="eager"
        class="profile-photo"
      />
    </div>
  </section>

  <!-- Strategic Services -->
  <section class="section">
    <h2 class="section-label">Strategic Services</h2>
    <div class="services-grid">
      <div class="service-card">
        <span class="service-card__number label-sm">1</span>
        <h3 class="headline-md">Architecture Audit</h3>
        <p class="body-md muted">
          Deep-dive into your codebase architecture, evaluating security risks, scalability limits,
          and reliability hazards to give you a prioritised action list.
        </p>
      </div>
      <div class="service-card">
        <span class="service-card__number label-sm accent">02</span>
        <h3 class="headline-md">Team Mentorship</h3>
        <p class="body-md muted">
          Closing the software engineering culture gap by developing engineering talent through
          pair programming, documentation, and leadership coaching.
        </p>
      </div>
    </div>
  </section>

  <!-- Aside quote -->
  <aside class="longevity-aside">
    <p class="body-lg">
      I believe in building software that lasts decades, not weeks. This means embracing clarity,
      documentation, and rigour over the latest framework trend. My approach is systematic,
      critical, and focused on the long-term ROI of your technical decisions.
    </p>
  </aside>

  <!-- Recent posts -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-label">Recent Thinking</h2>
      <a href="/blog/" class="label-sm accent-link">All Posts →</a>
    </div>
    <PostsList posts={recentPosts} />
  </section>

  <!-- Newsletter CTA -->
  <section class="newsletter">
    <h2 class="headline-md">Join my briefing.</h2>
    <p class="body-md muted">
      Occasional insights on software architecture, leadership, and the intersection of technical and
      societal concerns.
    </p>
    <form
      class="newsletter__form"
      action="https://buttondown.com/api/emails/embed-subscribe/cmolina"
      method="post"
    >
      <input
        type="email"
        name="email"
        placeholder="Email address"
        class="newsletter__input"
        aria-label="Email address"
        required
      />
      <button type="submit" class="btn-primary">Subscribe</button>
    </form>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 2rem;
    margin-bottom: 5rem;
    padding-top: 2rem;
  }

  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
  }

  .hero__text {
    flex: 1;
  }

  .hero__image {
    flex-shrink: 0;
  }

  :global(.profile-photo) {
    width: 200px;
    height: 200px;
    object-fit: cover;

    display: block;
  }

  @media (min-width: 768px) {
    :global(.profile-photo) {
      width: 240px;
      height: 240px;
    }
  }

  /* ---- Typography ---- */
  .headline-xl {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color);
    margin: 0 0 1.5rem;
  }

  .headline-md {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color);
    margin: 0 0 0.5rem;
  }

  .body-lg {
    font-size: 1.25rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .body-md {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
  }

  .muted {
    color: var(--on-surface-variant, #444748);
  }

  .label-sm {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .accent { color: var(--secondary, #5c3cdc); }

  /* ---- Buttons ---- */
  .btn-outline {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    border: 2px solid var(--color);
    color: var(--color);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s;
  }

  .btn-outline:hover {
    background-color: var(--color);
    color: var(--surface, #fbf9f8);
  }

  .btn-primary {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    background: var(--secondary, #5c3cdc);
    border: 2px solid var(--secondary, #5c3cdc);
    color: #fff;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s, border-color 0.3s;
  }

  .btn-primary:hover {
    background: var(--color);
    border-color: var(--color);
    color: var(--surface, #fbf9f8);
  }

  /* ---- Sections ---- */
  .section {
    margin-bottom: 5rem;
  }

  .section-label {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color);
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--outline-variant, #c4c7c7);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--outline-variant, #c4c7c7);
  }

  .section-header .section-label {
    margin: 0;
    padding: 0;
    border: none;
  }

  .accent-link {
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--secondary, #5c3cdc);
    text-decoration: none;
  }

  .accent-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--secondary, #5c3cdc);
  }

  /* ---- Services Grid ---- */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    padding: 1.5rem;
    border: 1px solid var(--outline-variant, #c4c7c7);
  }

  .service-card__number {
    display: block;
    margin-bottom: 1rem;
    color: var(--on-surface-variant, #444748);
  }

  /* ---- Aside ---- */
  .longevity-aside {
    border-left: 3px solid var(--secondary, #5c3cdc);
    padding-left: 1.5rem;
    margin-bottom: 5rem;
  }

  .longevity-aside .body-lg {
    font-style: italic;
    color: var(--on-surface-variant, #444748);
    font-size: 1.125rem;
    margin: 0;
  }

  /* ---- Newsletter ---- */
  .newsletter {
    background-color: var(--surface-container-low, #f5f3f3);
    border: 1px solid var(--outline-variant, #c4c7c7);
    padding: 2.5rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .newsletter .headline-md {
    margin-bottom: 0.75rem;
  }

  .newsletter .body-md {
    margin-bottom: 1.5rem;
    color: var(--on-surface-variant, #444748);
  }

  .newsletter__form {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .newsletter__input {
    flex: 1;
    max-width: 22rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--outline, #747878);
    background: var(--surface, #fbf8f8);
    color: var(--on-surface, #1a1c1c);
    font-size: 1rem;
    outline: none;
  }

  .newsletter__input::placeholder {
    color: var(--on-surface-variant, #444748);
  }

  .newsletter__input:focus {
    border-color: var(--primary, #006a6a);
  }

  /* ---- Override global article > h1 top-margin in hero ---- */
  h1 {
    margin-top: 0;
  }

  /* Preserve article > nav for post prev/next, override breadcrumbs-style navs */
  :global(article > nav) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    list-style: none;
    padding: 0 1rem calc(1.618 * 1rem);
  }
</style>
