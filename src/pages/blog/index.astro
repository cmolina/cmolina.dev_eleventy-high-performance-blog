---
export const meta = {
  title: 'Blog',
  description: 'Explorations in software engineering, technical leadership, and the intersection of music and code. Long-form thoughts for the curious mind.',
};

import { getCollection } from 'astro:content';
import { isPublished, sortByDate } from '../../utils/posts';
import Base from '../../layouts/Base.astro';
import PostsList from '../../components/PostsList.astro';

const allPosts = await getCollection('posts');
const posts = sortByDate(allPosts.filter(isPublished));
---

<Base title="Blog" description={meta.description}>
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span class="current" aria-current="page">Blog</span>
  </nav>

  <!-- Header -->
  <header class="page-header">
    <h1 class="headline-xl">Notes &amp; Prototypes</h1>
    <p class="body-lg muted">
      Explorations in software engineering, technical leadership, and the intersection of music
      and code. Long-form thoughts for the curious mind.
    </p>
  </header>

  <!-- Posts feed -->
  <div id="posts">
    <PostsList posts={posts} />
  </div>

  <!-- Newsletter -->
  <section class="newsletter">
    <h2 class="headline-md">Sustainable Updates</h2>
    <p class="body-md muted">
      Occasional insights on technical rigor and long-term software sustainability. No spam, ever.
    </p>
    <form
      class="newsletter__form"
      action="https://buttondown.com/api/emails/embed-subscribe/cmolina"
      method="post"
    >
      <input
        type="email"
        name="email"
        placeholder="Email address"
        class="newsletter__input"
        aria-label="Email address"
        required
      />
      <button type="submit" class="btn-outline">Subscribe</button>
    </form>
  </section>
</Base>

<style>
  /* ---- Breadcrumbs ---- */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    justify-content: flex-start;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs a { color: var(--on-surface-variant, #444748); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--color); }
  .breadcrumbs span { color: var(--on-surface-variant, #444748); }
  .breadcrumbs .current { color: var(--color); }

  /* ---- Typography ---- */
  .page-header {
    margin-bottom: 4rem;
  }

  .headline-xl {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color);
    margin: 0 0 1.5rem;
  }

  .headline-md {
    font-family: 'Manrope Variable', Manrope, system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color);
    margin: 0 0 0.75rem;
  }

  .body-lg { font-size: 1.25rem; line-height: 1.6; margin: 0; }
  .body-md { font-size: 1.125rem; line-height: 1.6; margin: 0; }
  .muted { color: var(--on-surface-variant, #444748); }

  /* ---- Newsletter ---- */
  .newsletter {
    background-color: var(--surface-container-low, #f5f3f3);
    border: 1px solid var(--outline-variant, #c4c7c7);
    padding: 2.5rem 3rem;
    margin-top: 5rem;
    position: relative;
    overflow: hidden;
  }

  .newsletter .headline-md { margin-bottom: 0.5rem; }
  .newsletter .body-md { margin-bottom: 2rem; }

  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 28rem;
  }

  @media (min-width: 480px) {
    .newsletter__form {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .newsletter__input {
    flex: 1;
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--outline-variant, #c4c7c7);
    padding: 0.5rem 0;
    font-family: 'Newsreader Variable', Newsreader, Georgia, serif;
    font-size: 1.125rem;
    color: var(--color);
    outline: none;
    transition: border-color 0.2s;
  }

  .newsletter__input::placeholder {
    color: var(--on-surface-variant, #444748);
    opacity: 0.7;
  }

  .newsletter__input:focus {
    border-bottom-color: var(--secondary, #5c3cdc);
  }

  .btn-outline {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    border: 2px solid var(--color);
    color: var(--color);
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s;
    white-space: nowrap;
  }

  .btn-outline:hover {
    background-color: var(--secondary, #5c3cdc);
    border-color: var(--secondary, #5c3cdc);
    color: #fff;
  }

  h1 { margin-top: 0; }
</style>
