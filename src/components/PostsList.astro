---
import type { CollectionEntry } from 'astro:content';
import { readableDate, htmlDateString } from '../utils/dates';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<div class="posts-list">
  {posts.map((post) => (
    <article class="post-item">
      <div class="post-item__header">
        <h2 class="post-item__title">
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </h2>
        <time
          class="post-item__date"
          datetime={htmlDateString(post.data.date)}
        >
          {readableDate(post.data.date).toUpperCase()}
        </time>
      </div>
      <div class="post-item__body">
        {post.data.description && (
          <p class="post-item__desc">{post.data.description}</p>
        )}
        <a href={`/posts/${post.id}/`} class="post-item__read">
          Read full entry
        </a>
      </div>
    </article>
  ))}
</div>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .post-item {
    border-top: 2px solid var(--secondary, #5c3cdc);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-item__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .post-item__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .post-item__title {
    font-family: Manrope, system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    color: var(--color);
  }

  .post-item__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .post-item__title a:hover {
    color: var(--secondary, #5c3cdc);
  }

  .post-item__date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--on-surface-variant, #444748);
    flex-shrink: 0;
  }

  .post-item__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-item__desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--on-surface-variant, #444748);
    margin: 0;
  }

  .post-item__read {
    display: inline-block;
    border-bottom: 2px solid var(--secondary, #5c3cdc);
    color: var(--secondary, #5c3cdc);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.25rem;
    transition: color 0.2s, border-color 0.2s;
    align-self: flex-start;
  }

  .post-item__read:hover {
    color: var(--color);
    border-color: var(--color);
  }
</style>
