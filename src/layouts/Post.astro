---
import Base from './Base.astro';
import { readableDate, htmlDateString } from '../utils/dates';
import { readTime } from '../utils/readTime';

interface Props {
  title: string;
  description?: string;
  date: Date;
  update?: Date;
  slug: string;
  body: string;
  tags?: string[];
  prevPost?: { url: string; title: string };
  nextPost?: { url: string; title: string };
}

const SITE_URL = 'https://cmolina.dev';
const personId = `${SITE_URL}/#person`;

const { title, description, date, update, slug, body, tags, prevPost, nextPost } = Astro.props;

const readMinutes = readTime(body);

const pageUrl = `/posts/${slug}/`;
const shareUrl = `${SITE_URL}${pageUrl}`;
const ogImage = `${SITE_URL}/og/${slug}.png`;

const personRef = { '@id': personId };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  image: [ogImage],
  author: personRef,
  publisher: personRef,
  url: shareUrl,
  mainEntityOfPage: shareUrl,
  datePublished: htmlDateString(date),
  dateModified: htmlDateString(update ?? date),
  description: description ?? '',
  inLanguage: 'en',
  wordCount: body.split(/\s+/).filter(Boolean).length,
  timeRequired: `PT${readMinutes}M`,
  articleSection: 'Software Engineering',
  ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
};
---

<Base title={title} description={description} pageUrl={pageUrl} ogImage={ogImage} ogType="article">
  <Fragment slot="header">
    <h1>{title}</h1>
    <aside>{readMinutes} min read.</aside>
    <span>
      Published <time datetime={htmlDateString(date)}>{readableDate(date)}</time>
      {update && update > date && (
        <> — Updated on <time datetime={htmlDateString(update)}>{readableDate(update)}</time></>
      )}
    </span>
  </Fragment>

  <slot />

  <p aria-label="Thank you!">🙏🙏🙏</p>
  <p>
    Since you've made it this far, <a href={shareUrl} id="share-link">sharing</a> this article on your
    favorite social media network would be highly appreciated.
  </p>

  <script>
    const link = document.getElementById('share-link') as HTMLAnchorElement | null;
    if (link) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const url = link.href;
        if (navigator.share) {
          navigator.share({ url });
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url);
          const dialog = document.getElementById('message') as HTMLDialogElement | null;
          if (dialog) {
            dialog.textContent = 'Article URL copied to clipboard.';
            dialog.setAttribute('open', '');
            setTimeout(() => dialog.removeAttribute('open'), 3000);
          }
        }
      });
    }
  </script>

  <p>In case you'd like to keep reading:</p>
  <nav>
    {prevPost && <a rel="prev" href={prevPost.url}>{prevPost.title}</a>}
    {nextPost && <a rel="next" href={nextPost.url}>{nextPost.title}</a>}
  </nav>

  <footer>
    <a href="https://github.com/cmolina/cmolina-blog" target="_blank" rel="noopener noreferrer">Link to source code</a>.
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  header > h1 {
    font-size: calc(var(--golden-ratio) * var(--golden-ratio) * 1rem);
    line-height: 3.5rem;
    margin: 0 0 2.03rem;
  }

  article > nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    list-style: none;
    padding: 0 1rem calc(var(--golden-ratio) * 1rem);
  }
</style>
