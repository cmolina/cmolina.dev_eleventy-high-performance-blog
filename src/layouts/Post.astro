---
import Base from './Base.astro';
import { readableDate, htmlDateString } from '../utils/dates';
import { readTime } from '../utils/readTime';

interface Props {
  title: string;
  description?: string;
  date: Date;
  update?: Date;
  slug: string;
  body: string;
  prevPost?: { url: string; title: string };
  nextPost?: { url: string; title: string };
}

const SITE_URL = 'https://cmolina.dev';
const AUTHOR_NAME = 'Carlos Andrés Molina Avendaño';
const GENRE = 'http://vocab.getty.edu/aat/300054641';
const PUBLISHER_NAME = 'Carlos Andrés Molina Avendaño';

const { title, description, date, update, slug, body, prevPost, nextPost } = Astro.props;

const readMinutes = readTime(body);

const pageUrl = `/blog/${slug}`;
const shareUrl = `${SITE_URL}${pageUrl}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  image: [],
  author: AUTHOR_NAME,
  genre: GENRE,
  publisher: {
    '@type': 'Organization',
    name: PUBLISHER_NAME,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/img/favicon/favicon-192x192.png`,
    },
  },
  url: shareUrl,
  mainEntityOfPage: shareUrl,
  datePublished: htmlDateString(date),
  description: description ?? '',
};
---

<Base title={title} description={description} pageUrl={pageUrl}>
  <Fragment slot="header">
    <h1>{title}</h1>
    <aside>{readMinutes} min read.</aside>
    <span>
      Published <time datetime={htmlDateString(date)}>{readableDate(date)}</time>
      {update && update > date && (
        <> — Updated on <time datetime={htmlDateString(update)}>{readableDate(update)}</time></>
      )}
    </span>
  </Fragment>

  <slot />

  <p aria-label="Thank you!">🙏🙏🙏</p>
  <p>
    Since you've made it this far, <a href={shareUrl} id="share-link">sharing</a> this article on your
    favorite social media network would be highly appreciated 😻! For feedback, please{' '}
    <a href="https://elk.zone/techhub.social/@cmolina" target="_blank" rel="noopener">ping me on Mastodon.</a>
  </p>

  <script>
    const link = document.getElementById('share-link') as HTMLAnchorElement | null;
    if (link) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const url = link.href;
        if (navigator.share) {
          navigator.share({ url });
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url);
          const dialog = document.getElementById('message') as HTMLDialogElement | null;
          if (dialog) {
            dialog.textContent = 'Article URL copied to clipboard.';
            dialog.setAttribute('open', '');
            setTimeout(() => dialog.removeAttribute('open'), 3000);
          }
        }
      });
    }
  </script>

  <p>In case you'd like to keep reading:</p>
  <nav>
    {prevPost && <a rel="prev" href={prevPost.url}>{prevPost.title}</a>}
    {nextPost && <a rel="next" href={nextPost.url}>{nextPost.title}</a>}
  </nav>

  <footer>
    <a href="https://github.com/cmolina/cmolina-blog" target="_blank" rel="noopener noreferrer">Link to source code</a>.
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
