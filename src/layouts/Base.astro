---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  pageUrl?: string;
}

const SITE_URL = 'https://cmolina.dev';
const SITE_TITLE = 'Carlos Molina';
const TWITTER_HANDLE = 'camolin3';

const {
  title,
  description,
  lang = 'en',
  pageUrl = Astro.url.pathname,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const ogImage = `${SITE_URL}/img/social${pageUrl}og-image.png`;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {isDev
      ? <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      : <link rel="icon" href="/img/favicon/favicon-192x192.png" type="image/png" />
    }
    <meta name="theme-color" content="#f9c412" />
    <meta name="robots" content="max-snippet:-1, max-image-preview: large, max-video-preview: -1" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    {description && (
      <>
        <meta name="description" content={description} />
        <meta property="og:description" content={description} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${TWITTER_HANDLE}`} />
    <meta name="twitter:creator" content={`@${TWITTER_HANDLE}`} />
    <meta property="og:image" content={ogImage} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title={SITE_TITLE} />
    <link rel="preconnect" href="/" crossorigin="" />
    <link rel="preload" href="/fonts/merriweather-latin-300-normal.woff2" as="font" type="font/woff2" media="(prefers-color-scheme: dark)" crossorigin="" />
    <link rel="preload" href="/fonts/merriweather-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="" />
    <style is:global>
      :root {
        --golden-ratio: 1.618;
        --line-thickness: max(.2rem, .16em);

        --background: #fff;
        --color: #000e;
        --lighter-color: #0009;
        --primary-color-1: #508;
        --primary-color-2: #80a;
        --font-weight: 400;
        --letter-spacing: normal;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --background: #123;
          --color: #fff;
          --lighter-color: #fff9;
          --primary-color-1: #d5f;
          --primary-color-2: #c7f;
          --font-weight: 300;
          --letter-spacing: .006rem;
        }
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <div class="centered-content">
      <header>
        <nav id="nav">
          <a href="/" title="Homepage" rel="index">{SITE_TITLE}</a>
          <a href="/blog">Blog (EN)</a>
          <a href="/services">Servicios</a>
        </nav>
        <slot name="header" />
        <dialog id="message"></dialog>
      </header>

      <main>
        <article>
          <slot />
        </article>
      </main>
    </div>
  </body>
</html>
