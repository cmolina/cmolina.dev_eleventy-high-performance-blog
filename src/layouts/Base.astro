---
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/main.css';
import favicon192 from '../assets/img/favicon/favicon-192x192.png';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  pageUrl?: string;
  ogImage?: string;
}

const SITE_URL = 'https://cmolina.dev';
const SITE_TITLE = 'Carlos Molina';
const TWITTER_HANDLE = 'camolin3';

const {
  title,
  description,
  lang = 'en',
  pageUrl = Astro.url.pathname,
  ogImage: ogImageProp,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const ogSlug = pageUrl === '/' ? 'home' : pageUrl.replace(/^\/|\/$/g, '');
const ogImage = ogImageProp ?? `${SITE_URL}/og/${ogSlug}.png`;
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {isDev
      ? <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      : <link rel="icon" href={favicon192.src} type="image/png" />
    }
    <meta name="theme-color" content="#f9c412" />
    <meta name="robots" content="max-snippet:-1, max-image-preview: large, max-video-preview: -1" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    {description && (
      <>
        <meta name="description" content={description} />
        <meta property="og:description" content={description} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${TWITTER_HANDLE}`} />
    <meta name="twitter:creator" content={`@${TWITTER_HANDLE}`} />
    <meta property="og:image" content={ogImage} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title={SITE_TITLE} />
    <link rel="preconnect" href="/" crossorigin="" />
    <link rel="preload" href="/fonts/merriweather-latin-300-normal.woff2" as="font" type="font/woff2" media="(prefers-color-scheme: dark)" crossorigin="" />
    <link rel="preload" href="/fonts/merriweather-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="" />
    <slot name="head" />
  </head>
  <body>
    <div class="centered-content">
      <header>
        <nav id="nav">
          <div id="reading-progress"></div>
          <a href="/" title="Homepage" rel="index">{SITE_TITLE}</a>
          <a href="/about/services/">Servicios</a>
          <a href="/about/values/">My Values (EN)</a>
          <a href="/about/me/">About Me (EN)</a>
          <a href="/blog/">Blog (EN)</a>
        </nav>
        <slot name="header" />
        <dialog id="message"></dialog>
      </header>

      <main>
        <article>
          <slot />
        </article>
      </main>
    </div>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
